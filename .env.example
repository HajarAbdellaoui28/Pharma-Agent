OPENAI_API_KEY=replace-with-your-syntax-key
OPENAI_BASE_URL=https://your-syntax-proxy.example/v1
# OPENAI_BASE_UR is also accepted; OPENAI_BASE_URL takes priority.
OPENAI_MODEL=gpt-5.6-terra
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
CORPUS_DIR=corpus
CACHE_DIR=.cache/embeddings
MAX_RESEARCH_ROUNDS=2
MAX_TOOL_ROUNDS=4
REQUEST_TIMEOUT_SECONDS=240
